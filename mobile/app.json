{
  "expo": {
    "name": "OneCalendar",
    "slug": "onecalendar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "ondalcalendar",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onecalendar.app"
    },
    "android": {
      "package": "com.onecalendar.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F2FF"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-status-bar"
    ]
  }
}
